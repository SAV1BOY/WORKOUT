NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# o e-mail do DONO: quem vê e muda o limite de contas em Mais → Contas (SPEC §21)
ALLOWED_EMAIL=miguelgsaviotti29@gmail.com
# lembretes no celular (SPEC §23). Sem as três, a tela Mais → Lembretes diz
# "Lembretes ainda não configurados neste servidor." e nada quebra.
# Gere um par P-256 (base64url): a pública tem 65 bytes, a privada 32.
# A privada é SEGREDO: só no servidor (Vercel: Sensitive), nunca no repositório.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
# disparo automático dos lembretes (SPEC §23.11): o MESMO valor que está no
# Vault do Supabase como `lembretes_segredo` (e `lembretes_url` = a URL de
# /api/lembretes/disparar). Sem ela, a rota responde 503 e nada sai sozinho.
# SEGREDO: só no servidor (Vercel: Sensitive), nunca no repositório.
LEMBRETES_SEGREDO=
